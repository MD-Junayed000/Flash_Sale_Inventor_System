APP_NAME="Flash Sale Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------
# Logging — stack of single + structured JSON channel
# ------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single,json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Toggle the correlation-id processor that adds `correlation_id` to every record.
LOG_CORRELATION_ENABLED=true

# ------------------------------------------------------------------
# Database (MySQL 8.0)
#   DB_HOST must be `db` on the Docker network.
# ------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=flash_sale
DB_USERNAME=sail
DB_PASSWORD=password

# ------------------------------------------------------------------
# Redis — used for both cache and queue
# ------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------
# Session
# ------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ------------------------------------------------------------------
# Queue — ProcessOrder jobs land on Redis for throughput
# ------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_NAME=orders
QUEUE_FAILED_DRIVER=database-uuids

# ------------------------------------------------------------------
# Cache — cooldown lock lives in Redis (multi-instance safe)
# ------------------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=flash_sale

# ------------------------------------------------------------------
# Sanctum — Personal Access Tokens for API auth
# ------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000
SANCTUM_GUARD=web

# ------------------------------------------------------------------
# Flash-Sale-specific configuration
# ------------------------------------------------------------------
PURCHASE_COOLDOWN_SECONDS=60
PURCHASE_COOLDON_STORE=redis
PURCHASE_QUEUE_CONNECTION=redis
PURCHASE_QUEUE_NAME=orders
PURCHASE_MAX_RETRIES=3
PURCHASE_BACKOFF=5,15,60

# Mystery discount distribution. Weights are relative; default 75/20/5.
PURCHASE_DISCOUNT_WEIGHT_NONE=75
PURCHASE_DISCOUNT_WEIGHT_TEN=20
PURCHASE_DISCOUNT_WEIGHT_FIFTY=5

# Rate limits (per minute)
PURCHASE_RATE_LIMIT_PER_MIN=30
PURCHASE_RATE_LIMIT_PER_IP_PER_MIN=120

# ------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
