APP_NAME="Flash Sale Inventory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL 8.0)
# ---------------------------------------------------------------------------
# When using the bundled Docker Compose stack, DB_HOST must be `db`
# (the service name) so PHP can resolve it on the Docker network.
# Outside Docker (e.g. local Laravel Sail or Homestead) override these.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=flash_sale
DB_USERNAME=sail
DB_PASSWORD=password

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ---------------------------------------------------------------------------
# Queue — ProcessOrder jobs land here
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Cache — cooldown lock
# ---------------------------------------------------------------------------
CACHE_STORE=file
CACHE_PREFIX=

# ---------------------------------------------------------------------------
# Flash Sale-specific configuration
# ---------------------------------------------------------------------------
# Seconds to lock the (user, sku) pair after a successful purchase.
# Set to 0 to disable the cooldown.
PURCHASE_COOLDOWN_SECONDS=60

# Optional: dedicated cache store for cooldown (defaults to CACHE_STORE)
# PURCHASE_COOLDOWN_STORE=redis

# Optional: dedicated queue for ProcessOrder (defaults to QUEUE_CONNECTION)
# PURCHASE_QUEUE_CONNECTION=redis
# PURCHASE_QUEUE_NAME=orders

# Mystery discount distribution. Weights are relative; default 75/20/5.
PURCHASE_DISCOUNT_WEIGHT_NONE=75
PURCHASE_DISCOUNT_WEIGHT_TEN=20
PURCHASE_DISCOUNT_WEIGHT_FIFTY=5

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
